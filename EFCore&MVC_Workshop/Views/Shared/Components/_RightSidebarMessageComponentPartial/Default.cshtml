@model List<Message>
<div class="tab-pane fade" id="chats-section" role="tabpanel" aria-labelledby="chats-section">
    <div class="d-flex align-items-center justify-content-between border-bottom">
        <p class="settings-heading border-top-0 mb-3 pl-3 pt-0 border-bottom-0 pb-0">Mesajlar</p>
        <small class="settings-heading border-top-0 mb-3 pt-0 border-bottom-0 pb-0 pr-3 font-weight-normal">Tümünü Gör</small>
    </div>
    <ul class="chat-list">
        @foreach (var item in Model)
        {
            <li class="list">
                <div class="profile">
                    <div class="avatar-letters d-flex align-items-center justify-content-center bg-primary text-white rounded-circle font-weight-bold" style="width: 40px; height: 40px;">
                        @(!string.IsNullOrEmpty(item.SenderNameSurname) ? item.SenderNameSurname.Substring(0, 1).ToUpper() : "M")
                    </div>
                    <span class="online"></span>
                </div>

                <div class="info">
                    <p>@item.SenderNameSurname</p>
                    <p>@item.MessageTitle</p>
                </div>
                <small class="text-muted my-auto">@item.DateTime.ToShortDateString()</small>
            </li>
        }
    </ul>
</div>