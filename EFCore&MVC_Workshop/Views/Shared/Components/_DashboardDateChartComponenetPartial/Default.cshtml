@model List<OrderDateViewModel>
@using Newtonsoft.Json

@{
    var dateLabels = Model.Select(x => x.Date).ToList();
    var orderCounts = Model.Select(x => x.Count).ToList();
}

<div class="col-md-6 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">
                <i class="fas fa-calendar-alt"></i> Günlük Sipariş Trendleri
            </h4>
            <canvas id="orders-chart-date-status" width="600" height="600"></canvas>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    window.addEventListener('DOMContentLoaded', () => {
        const labels = @Html.Raw(JsonConvert.SerializeObject(dateLabels));
        const counts = @Html.Raw(JsonConvert.SerializeObject(orderCounts));

        // Tarayıcı konsolundan gelen verileri mutlaka kontrol edin:
        console.log("Labels:", labels);
        console.log("Counts:", counts);

        const ctx = document.getElementById('orders-chart-date-status').getContext('2d');
        const chart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Günlük Sipariş Sayısı',
                    data: counts,
                    fill: true, // Alt alanın dolgulu olması dalgaları daha belirgin yapar
                    backgroundColor: 'rgba(75, 192, 192, 0.1)', // Hafif şeffaf arka plan
                    borderColor: 'rgba(75, 192, 192, 1)',
                    borderWidth: 3, // Çizgiyi biraz kalınlaştırarak daha net gösterdik
                    tension: 0.45, // Dalga/kavis seviyesini artırdık (0 ile 1 arası)
                    pointBackgroundColor: 'rgba(75, 192, 192, 1)',
                    pointRadius: 4, // Noktaları biraz daha belirgin yaptık
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        display: true
                    }
                },
                scales: {
                    x: {
                        title: {
                            display: true,
                            text: 'Tarih'
                        },
                        grid: {
                            display: false // X eksenindeki dikey çizgileri kaldırarak temiz bir görüntü sağlar
                        }
                    },
                    y: {
                        beginAtZero: true,
                        title: {
                            display: true,
                            text: 'Sipariş Sayısı'
                        },
                        ticks: {
                            precision: 0 // Sipariş sayıları tam sayı olacağı için küsuratları (0.2, 0.4 gibi) gizler
                        }
                    }
                }
            }
        });
    });
</script>